# Provider keys — both can also be set at runtime from the admin panel's
# API Keys page (no restart needed); a key set there takes priority over
# these. Leave either blank and its task types fail with a clear
# "not configured" error instead of silently falling back to something else.

# See https://console.anthropic.com for a key.
ANTHROPIC_API_KEY=

# Powers image generation (gpt-image-1) — see https://platform.openai.com/api-keys.
OPENAI_API_KEY=

# Postgres connection string for accounts / sessions / oauth_states.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/convergers_ai

# Google OAuth (create via Docs/frontend-plan/google-oauth-setup.md).
# Redirect URI must match the Cloud Console entry exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/auth/google/callback

# Optional overrides (defaults shown):
# PORT=8787
# WEB_ORIGIN=http://localhost:3000
# ADMIN_ORIGIN=http://localhost:3002
# SIGNUP_GRANT_CREDITS=100
# DEMO_STARTING_CREDITS=100000
# SESSION_COOKIE_NAME=convergers_session
# SESSION_TTL_DAYS=14
# COOKIE_SECURE=false
# COOKIE_SAMESITE=Lax
# Use COOKIE_SAMESITE=None only when the web app and API are on different sites
# (e.g. app.example.com → api.other.com). None forces Secure regardless of COOKIE_SECURE.
